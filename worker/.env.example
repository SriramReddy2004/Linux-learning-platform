# Worker Configuration
WORKER_ID=worker-1
PORT=3001
NODE_ENV=production

# Master/Backend Configuration
MASTER_URL=http://localhost:3000

# Docker Configuration
DOCKER_HOST=unix
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_IMAGE=play-with-linux
CPU_QUOTA=200000
MEMORY_LIMIT=536870912

# Health Reporting
HEALTH_REPORT_INTERVAL=30000

# Worker Secret
WORKER_SECRET=worker-default-secret-change-this
